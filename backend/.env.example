PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# Frontend origin for CORS, Chapa return_url, and email redirects (no trailing slash)
# NEVER use placeholder hostnames like your-app.vercel.app or your-vercel-frontend-url.vercel.app on Railway.
#
# Local:
FRONTEND_URL=http://localhost:3000
#
# Production (Railway) — use your real Vercel production domain:
#   FRONTEND_URL=https://book-nest-frontend-v2-main.vercel.app
#
# Supabase Dashboard → Authentication → URL Configuration:
#   Site URL: same as FRONTEND_URL
#   Redirect URLs:
#     {FRONTEND_URL}/reset-password
#     {FRONTEND_URL}/verify
#     {FRONTEND_URL}/auth/verify
#     {FRONTEND_URL}/auth/callback

# Public backend URL — Chapa callback_url webhook (https://, no trailing slash)
# Local:
BACKEND_URL=http://localhost:5000
#
# Production (Railway):
#   BACKEND_URL=https://book-nest-webapp-production.up.railway.app
#
# Chapa dashboard → Webhooks:
#   https://book-nest-webapp-production.up.railway.app/api/webhooks/chapa

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Must be the service_role secret (NOT anon). Wrong key → "permission denied for table transaction_items"
SUPABASE_SERVICE_ROLE_KEY=

# Auth
JWT_SECRET=
# Development: true = password reset / resend use direct links (no Supabase email quota). Default on when NODE_ENV=development.
AUTH_RELAX_EMAIL_LIMITS=true
# Hint shown when Supabase still rate-limits (minutes)
AUTH_EMAIL_RATE_LIMIT_HINT_MINUTES=60

# Chapa (https://dashboard.chapa.co)
#
# Railway (backend) production checklist:
#   FRONTEND_URL=https://book-nest-frontend-v2-main.vercel.app
#   BACKEND_URL=https://book-nest-webapp-production.up.railway.app
#   NODE_ENV=production
#   CHAPA_SECRET_KEY=<test or live key from Chapa dashboard>
#   CHAPA_WEBHOOK_SECRET=<from Chapa webhook settings>
#
# Vercel (frontend):
#   NEXT_PUBLIC_API_URL=https://book-nest-webapp-production.up.railway.app
#
# After deploy, check Railway logs for:
#   chapa_return: https://book-nest-frontend-v2-main.vercel.app/checkout/result
#
# Run on Supabase before cart checkout:
#   migrations/20260528_cart_checkout.sql
#   migrations/20260529_transaction_items_grants.sql
#
# Smoke test:
#   1. GET {BACKEND_URL}/api/health → OK
#   2. Login from Vercel → checkout → Chapa → land on /checkout/result → /library
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=

# Transactional email via Resend (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=BookNest <noreply@yourdomain.com>
