PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# Frontend origin for CORS and email redirects (no trailing slash)
# Supabase Dashboard → Authentication → URL Configuration:
#   Site URL: same as FRONTEND_URL (e.g. https://your-app.vercel.app)
#   Redirect URLs — add all of these for your FRONTEND_URL:
#     {FRONTEND_URL}/reset-password
#     {FRONTEND_URL}/verify
#     {FRONTEND_URL}/auth/verify
#     {FRONTEND_URL}/auth/callback
FRONTEND_URL=http://localhost:3000

# Public backend URL for payment callbacks and Chapa webhooks (no trailing slash)
# Production example: https://your-api.railway.app
BACKEND_URL=http://localhost:5000

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auth
JWT_SECRET=
# Development: true = password reset / resend use direct links (no Supabase email quota). Default on when NODE_ENV=development.
AUTH_RELAX_EMAIL_LIMITS=true
# Hint shown when Supabase still rate-limits (minutes)
AUTH_EMAIL_RATE_LIMIT_HINT_MINUTES=60

# Chapa (https://dashboard.chapa.co)
# Railway + Vercel (free domains) production setup:
#
# Railway (backend):
#   FRONTEND_URL=https://your-app.vercel.app
#   BACKEND_URL=https://your-api.up.railway.app
#   NODE_ENV=production
#   CHAPA_SECRET_KEY=<live key from Chapa dashboard>
#   CHAPA_WEBHOOK_SECRET=<from Chapa webhook settings>
#
# Vercel (frontend):
#   NEXT_PUBLIC_API_URL=https://your-api.up.railway.app
#
# Chapa dashboard → Webhooks:
#   URL: {BACKEND_URL}/api/webhooks/chapa
#   Example: https://your-api.up.railway.app/api/webhooks/chapa
#
# Run on Supabase before cart checkout:
#   migrations/20260528_cart_checkout.sql
#
# Smoke test after deploy:
#   1. GET {BACKEND_URL}/api/health → OK
#   2. Login from Vercel → cookie + GET /api/auth/me works
#   3. Checkout → Chapa → pay → redirect to /checkout/result
#   4. Railway logs: webhook received, purchase in library
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=

# Transactional email via Resend (https://resend.com) — avoids Supabase email quotas
# When RESEND_API_KEY is set, signup / reset / resend use BookNest emails via Resend.
# EMAIL_FROM: use a verified domain in production. If omitted, defaults to onboarding@resend.dev (testing only).
RESEND_API_KEY=
EMAIL_FROM=BookNest <noreply@yourdomain.com>
