PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# Frontend origin for CORS, Chapa return_url, and email redirects (no trailing slash)
# NEVER use placeholder hostnames like your-app.vercel.app or your-vercel-frontend-url.vercel.app on Railway.
#
# Local:
FRONTEND_URL=http://localhost:3000
#
# Production (Railway) — main reader app (emails, checkout, password reset):
#   FRONTEND_URL=https://book-nest-frontend-v2-main.vercel.app
#
# Production (Railway) — admin console (CORS only; separate Vercel project):
#   ADMIN_FRONTEND_URL=https://your-admin-app.vercel.app
#
# Optional comma-separated extra origins (custom domains):
#   ALLOWED_ORIGINS=https://admin.booknest.com,https://app.booknest.com
#
# Supabase Dashboard → Authentication → URL Configuration:
#   Site URL: https://book-nest-frontend-v2-main.vercel.app
#   Redirect URLs (add all):
#     https://book-nest-frontend-v2-main.vercel.app/auth/callback
#     https://book-nest-frontend-v2-main.vercel.app/auth/callback?intent=verify
#     https://book-nest-frontend-v2-main.vercel.app/auth/callback?intent=recovery
#     https://book-nest-frontend-v2-main.vercel.app/reset-password
#     https://book-nest-frontend-v2-main.vercel.app/verify
#     https://book-nest-frontend-v2-main.vercel.app/auth/verify
#
# Email confirmation flow:
#   1. User registers → backend creates Supabase user + sends verification email
#   2. User clicks link → /auth/verify → /verify → POST /api/auth/confirm-email → login
#
# Production (Railway): set AUTH_EMAIL_PROVIDER=supabase (see below)
# Local: Gmail SMTP via AUTH_EMAIL_PROVIDER=auto (default)

# Public backend URL — Chapa callback_url webhook (https://, no trailing slash)
# Local:
BACKEND_URL=http://localhost:5000
#
# Production (Railway):
#   BACKEND_URL=https://book-nest-webapp-production.up.railway.app
#
# Chapa dashboard → Webhooks:
#   https://book-nest-webapp-production.up.railway.app/api/webhooks/chapa

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Must be the service_role secret (NOT anon). Wrong key → "permission denied for table transaction_items"
SUPABASE_SERVICE_ROLE_KEY=

# Auth email — verification + password reset
#
# Production (Railway) — recommended when Brevo/Resend/Gmail SMTP fail:
#   AUTH_EMAIL_PROVIDER=supabase
#   NODE_ENV=production
#   FRONTEND_URL=https://your-vercel-app.vercel.app
#   Remove BREVO_API_KEY / RESEND_API_KEY if they error — Supabase sends the mail.
#   Supabase Dashboard → Authentication → URL Configuration: Site URL + redirect URLs
#   Optional: Authentication → SMTP Settings → add Gmail there (Supabase sends, not Railway)
#
# Local development — Gmail SMTP works from your machine:
#   AUTH_EMAIL_PROVIDER=auto   (default: tries SMTP first, then Supabase fallback)
#   SMTP_HOST=smtp.gmail.com   SMTP_USER=...   SMTP_PASS=app-password
#   AUTH_RELAX_EMAIL_LIMITS=true  logs links to console if all transports fail
#
# Values: auto | supabase | smtp | custom
#   auto     — prod: brevo→resend→supabase (NO SMTP, no 15s timeout). local: smtp first
#   supabase — auth emails via Supabase only
#   smtp     — force Gmail/custom SMTP (local only)
#   custom   — BookNest templates via brevo/resend/smtp, never Supabase
AUTH_EMAIL_PROVIDER=auto
BREVO_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=
# Local / Railway Pro SMTP (Gmail app password works locally, often times out on Railway):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# When SMTP is not set: in development (or AUTH_RELAX_EMAIL_LIMITS=true) links are logged to the server console instead of emailed.
AUTH_RELAX_EMAIL_LIMITS=true
AUTH_EMAIL_RATE_LIMIT_HINT_MINUTES=60

# Chapa (https://dashboard.chapa.co)
#
# Railway (backend) production checklist:
#   FRONTEND_URL=https://book-nest-frontend-v2-main.vercel.app
#   BACKEND_URL=https://book-nest-webapp-production.up.railway.app
#   NODE_ENV=production
#   CHAPA_SECRET_KEY=<test or live key from Chapa dashboard>
#   CHAPA_WEBHOOK_SECRET=<from Chapa webhook settings>
#
# Vercel (frontend):
#   NEXT_PUBLIC_API_URL=https://book-nest-webapp-production.up.railway.app
#
# After deploy, check Railway logs for:
#   chapa_return: https://book-nest-frontend-v2-main.vercel.app/checkout/result
#
# Run on Supabase before cart checkout:
#   migrations/20260528_cart_checkout.sql
#   migrations/20260529_transaction_items_grants.sql
#
# Smoke test:
#   1. GET {BACKEND_URL}/api/health → OK
#   2. Login from Vercel → checkout → Chapa → land on /checkout/result → /library
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=

# Seller platform fee (percent deducted from each sale before crediting wallet)
PLATFORM_FEE_PERCENT=15
