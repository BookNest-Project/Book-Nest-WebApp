PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# Frontend origin for CORS, Chapa return_url, and email redirects (no trailing slash)
# NEVER use placeholder hostnames like your-app.vercel.app or your-vercel-frontend-url.vercel.app on Railway.
#
# Local:
FRONTEND_URL=http://localhost:3000
#
# Production (Railway) — use your real Vercel production domain:
#   FRONTEND_URL=https://book-nest-frontend-v2-main.vercel.app
#
# Supabase Dashboard → Authentication → URL Configuration:
#   Site URL: https://book-nest-frontend-v2-main.vercel.app
#   Redirect URLs (add all):
#     https://book-nest-frontend-v2-main.vercel.app/auth/verify
#     https://book-nest-frontend-v2-main.vercel.app/verify
#     https://book-nest-frontend-v2-main.vercel.app/reset-password
#     https://book-nest-frontend-v2-main.vercel.app/auth/callback
#
# Email confirmation flow (already implemented in code):
#   1. User registers → backend creates Supabase user + sends BookNest-branded email (Resend/Brevo/SMTP)
#   2. User clicks link → lands on /auth/verify → /verify → POST /api/auth/confirm-email → login
#
# YOUR Supabase Dashboard checklist:
#   Authentication → Providers → Email → Enable email provider
#   Authentication → Settings → Enable "Confirm email" (users must verify before login in BookNest)
#   Authentication → URL Configuration:
#     Site URL = your production FRONTEND_URL
#     Redirect URLs: copy from Railway startup log (auth_verify_redirect) plus /verify and /auth/callback
#   Authentication → Email Templates: optional — customize copy, but TURN OFF "Send confirmation email"
#     if Supabase would send its own mail (BookNest backend sends via RESEND/BREVO below to avoid duplicates)
#   Optional: Authentication → SMTP Settings → custom SMTP only if you want Supabase to send instead of Resend
#
# YOUR Railway / backend env:
#   FRONTEND_URL=https://book-nest-frontend-v2-main.vercel.app  (must match Supabase Site URL)
#   RESEND_API_KEY or BREVO_API_KEY + EMAIL_FROM
#   AUTH_RELAX_EMAIL_LIMITS=false in production (links only in real emails, not console)

# Public backend URL — Chapa callback_url webhook (https://, no trailing slash)
# Local:
BACKEND_URL=http://localhost:5000
#
# Production (Railway):
#   BACKEND_URL=https://book-nest-webapp-production.up.railway.app
#
# Chapa dashboard → Webhooks:
#   https://book-nest-webapp-production.up.railway.app/api/webhooks/chapa

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Must be the service_role secret (NOT anon). Wrong key → "permission denied for table transaction_items"
SUPABASE_SERVICE_ROLE_KEY=

# Auth email — production on Railway (SMTP/Gmail is usually blocked):
#
# OPTION A — Resend (works NOW, no Brevo approval):
#   1. https://resend.com → API Keys → create key
#   2. Railway variables (do NOT set BREVO_API_KEY until Brevo is activated):
#        RESEND_API_KEY=re_xxxx
#        EMAIL_FROM=BookNest <onboarding@resend.dev>
#   3. Sandbox: only delivers to the email on your Resend account. For all users, verify a domain in Resend.
#
# OPTION B — Brevo (300/day free, after support activates transactional API):
#   1. Brevo → Help → ask to activate transactional/API sending
#   2. Settings → Senders → verify your Gmail
#   3. BREVO_API_KEY=...  EMAIL_FROM=BookNest <your-verified@gmail.com>
#   If Brevo fails, backend auto-falls back to Resend when RESEND_API_KEY is also set.
#
# Railway quick fix for "Brevo not activated": DELETE BREVO_API_KEY, keep RESEND_API_KEY only.
BREVO_API_KEY=
EMAIL_FROM=BookNest <onboarding@resend.dev>
RESEND_API_KEY=
#
# Local / Railway Pro SMTP (Gmail app password works locally, often times out on Railway):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# When SMTP is not set: in development (or AUTH_RELAX_EMAIL_LIMITS=true) links are logged to the server console instead of emailed.
AUTH_RELAX_EMAIL_LIMITS=true
AUTH_EMAIL_RATE_LIMIT_HINT_MINUTES=60

# Chapa (https://dashboard.chapa.co)
#
# Railway (backend) production checklist:
#   FRONTEND_URL=https://book-nest-frontend-v2-main.vercel.app
#   BACKEND_URL=https://book-nest-webapp-production.up.railway.app
#   NODE_ENV=production
#   CHAPA_SECRET_KEY=<test or live key from Chapa dashboard>
#   CHAPA_WEBHOOK_SECRET=<from Chapa webhook settings>
#
# Vercel (frontend):
#   NEXT_PUBLIC_API_URL=https://book-nest-webapp-production.up.railway.app
#
# After deploy, check Railway logs for:
#   chapa_return: https://book-nest-frontend-v2-main.vercel.app/checkout/result
#
# Run on Supabase before cart checkout:
#   migrations/20260528_cart_checkout.sql
#   migrations/20260529_transaction_items_grants.sql
#
# Smoke test:
#   1. GET {BACKEND_URL}/api/health → OK
#   2. Login from Vercel → checkout → Chapa → land on /checkout/result → /library
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=

# Seller platform fee (percent deducted from each sale before crediting wallet)
PLATFORM_FEE_PERCENT=15
